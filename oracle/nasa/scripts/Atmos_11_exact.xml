<?xml version="1.0"?>
<!--
  SPDX-License-Identifier: LGPL-2.1-or-later
  Check-case 11 from the exact trim of
  aircraft/f16/reset_Atmos_11_exact.xml, trimmed subsonic F-16, controls
  fixed and stability augmentation off: Appendix C.1.11, Table 35; 180 s
  duration.
  Written for jsbsim-rs from the parameters in NASA/TM-2015-218675,
  "Check-Cases for Verification of 6-Degree-of-Freedom Flight Vehicle
  Simulations", Volume II: Appendices.
-->
<runscript name="NASA EOM check-case Atmos 11, exact trim">
  <description>Check-case 11 of NASA/TM-2015-218675: steady flight of a subsonic aircraft</description>
  <use aircraft="f16" initialize="reset_Atmos_11_exact"/>
  <run start="0.0" end="180" dt="0.0025">
    <!--
      Adams-Bashforth 4 for every integrator at dt = 0.0025 s, for the
      convergence and stability reasons in the F-16 section of
      oracle/nasa/manifest.toml.
    -->
    <property value="5"> simulation/integrator/rate/rotational </property>
    <property value="5"> simulation/integrator/rate/translational </property>
    <property value="5"> simulation/integrator/position/rotational </property>
    <property value="5"> simulation/integrator/position/translational </property>
    <!-- The trim inputs of reset_Atmos_11_exact.xml's Newton solve. -->
    <property value="0.1387385812110044"> fcs/throttle-cmd-norm[0] </property>
    <property value="0.12930962358336048"> fcs/pitch-trim-cmd-norm </property>
  </run>
</runscript>
