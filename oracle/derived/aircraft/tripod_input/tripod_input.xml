<?xml version="1.0"?>
<!--
  SPDX-License-Identifier: LGPL-2.1-or-later
  tripod_input: tripod_ground with two <input> directives whose functions
  write properties.
  tripod_ground: tests/tripod.xml as JSBSim's tests/TestGndReactions.py
  flies it, with the 1000 slug ft2 inertias tests/TestMassChangeOnGround.py
  gives it to stand untrimmed at 120 Hz. Regenerate with `oracle derive`.
-->
<fdm_config version="2.0" release="ALPHA">
  <fileheader/>
  <metrics/>
  <mass_balance>
    <ixx unit="SLUG*FT2">1000.0</ixx>
    <iyy unit="SLUG*FT2">1000.0</iyy>
    <izz unit="SLUG*FT2">1000.0</izz>
    <emptywt unit="LBS"> 3000 </emptywt>
    <pointmass name="PILOT">
      <weight unit="LBS">0.0</weight>
      <location unit="FT">
        <x> 0.25 </x>
        <y> 0.0 </y>
        <z> 0.0 </z>
      </location>
    </pointmass>
  </mass_balance>
  <ground_reactions>
    <contact type="STRUCTURE" name="NOSE">
      <location unit="FT">
        <x> 1.0 </x>
        <y> 0.0 </y>
        <z> -0.2 </z>
      </location>
      <spring_coeff unit="LBS/FT"> 10000 </spring_coeff>
      <damping_coeff unit="LBS/FT/SEC"> 1000 </damping_coeff>
      <static_friction> 0.1 </static_friction>
      <dynamic_friction> 0.1 </dynamic_friction>
    </contact>
    <contact type="STRUCTURE" name="LEFT">
      <location unit="FT">
        <x> -0.5 </x>
        <y> 1.0 </y>
        <z> -0.2 </z>
      </location>
      <spring_coeff unit="LBS/FT"> 10000 </spring_coeff>
      <damping_coeff unit="LBS/FT/SEC"> 1000 </damping_coeff>
      <static_friction> 0.1 </static_friction>
      <dynamic_friction> 0.1 </dynamic_friction>
    </contact>
    <contact type="STRUCTURE" name="RIGHT">
      <location unit="FT">
        <x> -0.5 </x>
        <y> -1.0 </y>
        <z> -0.2 </z>
      </location>
      <spring_coeff unit="LBS/FT"> 10000 </spring_coeff>
      <damping_coeff unit="LBS/FT/SEC"> 1000 </damping_coeff>
      <static_friction> 0.1 </static_friction>
      <dynamic_friction> 0.1 </dynamic_friction>
    </contact>
  </ground_reactions>
  <aerodynamics/>
  <input>
    <property value="2.5">test/input/gain</property>
    <property value="0">test/input/counter</property>
    <property value="0">test/input/sum</property>
    <property value="0">test/input/post</property>
    <function copyto="test/input/counter">
      <sum><property>test/input/counter</property><property>test/input/gain</property></sum>
    </function>
    <function copyto="test/input/sum">
      <sum>
        <property>test/input/sum</property>
        <property>position/h-sl-ft</property>
        <property>forces/fbz-gear-lbs</property>
      </sum>
    </function>
    <function type="post" copyto="test/input/post">
      <product><property>test/input/counter</property><property>test/input/sum</property></product>
    </function>
  </input>
  <input type="QTJSBSIM" port="5139" rate="20">
    <property value="0">test/input/udp-counter</property>
    <function copyto="test/input/udp-counter">
      <sum><property>test/input/udp-counter</property><value>1</value></sum>
    </function>
  </input>
</fdm_config>
