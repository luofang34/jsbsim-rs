<?xml version="1.0"?>
<!--
  SPDX-License-Identifier: LGPL-2.1-or-later
  A 2000 lb four-wheeled rover with no aerodynamics or engine, made to
  exercise what FGLGear computes on the ground: a steerable nose wheel
  with square-law damping and its own rebound damping, a main wheel with a
  CORNERING_COEFF table, one whose strut is a <strut_force> function, a
  castered tail wheel in the CENTER brake group, the LEFT and RIGHT brake
  groups, retractable nose and main gear, and three STRUCTURE skids the
  rover slides on once they are up. The gear_rover_* goldens drive it.
-->
<fdm_config name="gear_rover" version="2.0" release="ALPHA">
  <fileheader/>
  <metrics/>
  <mass_balance>
    <ixx unit="SLUG*FT2"> 800 </ixx>
    <iyy unit="SLUG*FT2"> 1500 </iyy>
    <izz unit="SLUG*FT2"> 2000 </izz>
    <emptywt unit="LBS"> 2000 </emptywt>
    <location name="CG" unit="IN">
      <x> 100 </x>
      <y> 0 </y>
      <z> 30 </z>
    </location>
  </mass_balance>
  <ground_reactions>
    <contact type="BOGEY" name="NOSE">
      <location unit="IN"> <x> 40 </x> <y> 0 </y> <z> 0 </z> </location>
      <static_friction> 0.8 </static_friction>
      <dynamic_friction> 0.5 </dynamic_friction>
      <rolling_friction> 0.02 </rolling_friction>
      <spring_coeff unit="LBS/FT"> 4000 </spring_coeff>
      <damping_coeff type="SQUARE" unit="LBS/FT2/SEC2"> 100 </damping_coeff>
      <damping_coeff_rebound unit="LBS/FT/SEC"> 600 </damping_coeff_rebound>
      <max_steer unit="DEG"> 30 </max_steer>
      <brake_group> NONE </brake_group>
      <retractable> 1 </retractable>
    </contact>
    <contact type="BOGEY" name="LEFT_MAIN">
      <location unit="IN"> <x> 110 </x> <y> -40 </y> <z> 0 </z> </location>
      <static_friction> 0.8 </static_friction>
      <dynamic_friction> 0.5 </dynamic_friction>
      <rolling_friction> 0.03 </rolling_friction>
      <spring_coeff unit="LBS/FT"> 6000 </spring_coeff>
      <damping_coeff unit="LBS/FT/SEC"> 400 </damping_coeff>
      <table name="CORNERING_COEFF" type="internal">
        <tableData>
          -90  -0.6
          -10  -0.6
            0   0.0
           10   0.6
           90   0.6
        </tableData>
      </table>
      <max_steer unit="DEG"> 0 </max_steer>
      <brake_group> LEFT </brake_group>
      <retractable> 1 </retractable>
    </contact>
    <contact type="BOGEY" name="RIGHT_MAIN">
      <location unit="IN"> <x> 110 </x> <y> 40 </y> <z> 0 </z> </location>
      <static_friction> 0.8 </static_friction>
      <dynamic_friction> 0.5 </dynamic_friction>
      <rolling_friction> 0.03 </rolling_friction>
      <strut_force>
        <function>
          <sum>
            <product>
              <property>gear/unit[2]/compression-ft</property>
              <value> -6000 </value>
            </product>
            <product>
              <property>gear/unit[2]/compression-velocity-fps</property>
              <value> -400 </value>
            </product>
          </sum>
        </function>
      </strut_force>
      <max_steer unit="DEG"> 0 </max_steer>
      <brake_group> RIGHT </brake_group>
      <retractable> 1 </retractable>
    </contact>
    <contact type="BOGEY" name="TAIL">
      <location unit="IN"> <x> 180 </x> <y> 0 </y> <z> 0 </z> </location>
      <static_friction> 0.6 </static_friction>
      <dynamic_friction> 0.4 </dynamic_friction>
      <rolling_friction> 0.05 </rolling_friction>
      <spring_coeff unit="LBS/FT"> 3000 </spring_coeff>
      <damping_coeff unit="LBS/FT/SEC"> 300 </damping_coeff>
      <max_steer unit="DEG"> 360 </max_steer>
      <brake_group> CENTER </brake_group>
    </contact>
    <contact type="STRUCTURE" name="FWD_SKID">
      <location unit="IN"> <x> 50 </x> <y> 0 </y> <z> 14 </z> </location>
      <static_friction> 0.6 </static_friction>
      <dynamic_friction> 0.4 </dynamic_friction>
      <spring_coeff unit="LBS/FT"> 20000 </spring_coeff>
      <damping_coeff unit="LBS/FT/SEC"> 2000 </damping_coeff>
    </contact>
    <contact type="STRUCTURE" name="LEFT_SKID">
      <location unit="IN"> <x> 130 </x> <y> -30 </y> <z> 14 </z> </location>
      <static_friction> 0.6 </static_friction>
      <dynamic_friction> 0.4 </dynamic_friction>
      <spring_coeff unit="LBS/FT"> 20000 </spring_coeff>
      <damping_coeff unit="LBS/FT/SEC"> 2000 </damping_coeff>
    </contact>
    <contact type="STRUCTURE" name="RIGHT_SKID">
      <location unit="IN"> <x> 130 </x> <y> 30 </y> <z> 14 </z> </location>
      <static_friction> 0.6 </static_friction>
      <dynamic_friction> 0.4 </dynamic_friction>
      <spring_coeff unit="LBS/FT"> 20000 </spring_coeff>
      <damping_coeff unit="LBS/FT/SEC"> 2000 </damping_coeff>
    </contact>
  </ground_reactions>
  <aerodynamics/>
</fdm_config>
