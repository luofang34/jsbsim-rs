<?xml version="1.0" encoding="UTF-8"?>
<runscript name="gear rover drop">
  <!--
    SPDX-License-Identifier: LGPL-2.1-or-later
    gear_rover dropped onto its wheels while moving and sinking: the
    touchdown compresses the struts fast (the compression speed limited by
    the compression over the step), they rebound, and the rover rolls out
    with every brake on until it rests.
  -->
  <use aircraft="gear_rover" initialize="drop"/>
  <run start="0.0" end="15.0" dt="0.008333333333333333">
    <event name="Brakes">
      <condition>simulation/sim-time-sec ge 3.0</condition>
      <set name="fcs/left-brake-cmd-norm" value="0.8"/>
      <set name="fcs/right-brake-cmd-norm" value="0.8"/>
      <set name="fcs/center-brake-cmd-norm" value="0.8"/>
    </event>
  </run>
</runscript>
