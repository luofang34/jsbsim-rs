<?xml version="1.0" encoding="UTF-8"?>
<runscript name="gear rover deck rotating">
  <!--
    SPDX-License-Identifier: LGPL-2.1-or-later
    gear_rover on the "deck-rotating" ground callback (its golden's
    manifest names it), a deck spinning about a point 30 ft south: the
    friction swings the rover round, and once every brake locks it turns
    with the deck.
  -->
  <use aircraft="gear_rover" initialize="deck"/>
  <run start="0.0" end="12.0" dt="0.008333333333333333">
    <event name="Brakes">
      <condition>simulation/sim-time-sec ge 2.0</condition>
      <set name="fcs/left-brake-cmd-norm" value="1.0"/>
      <set name="fcs/right-brake-cmd-norm" value="1.0"/>
      <set name="fcs/center-brake-cmd-norm" value="1.0"/>
    </event>
  </run>
</runscript>
